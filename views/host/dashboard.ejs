<%- include('../partials/head') %>
</head>

<body class="bg-gray-100">

  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto p-8">

    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">

      <h1 class="text-4xl font-bold text-red-500 mb-2">
        Welcome Back, Host!
      </h1>

      <p class="text-gray-600 text-lg mb-6">
        Manage your properties and track bookings
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-lg p-6">
          <h3 class="text-3xl font-bold mb-2"><%= totalHomes %></h3>
          <p class="text-lg">Active Homes</p>
        </div>

        <div class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-lg p-6">
          <h3 class="text-3xl font-bold mb-2"><%= totalBookings %></h3>
          <p class="text-lg">Total Bookings</p>
        </div>

        <div class="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-lg p-6">
          <h3 class="text-3xl font-bold mb-2">Rs <%= totalEarnings %></h3>
          <p class="text-lg">Total Earnings</p>
        </div>

      </div>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="bg-white rounded-lg shadow-lg p-8">

        <h2 class="text-2xl font-bold text-gray-800 mb-4">
          My Properties
        </h2>

        <p class="text-gray-600 mb-6">
          Manage your homes and property details
        </p>

        <div class="flex gap-4">

          <a
            href="/host/add-home"
            class="bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-semibold transition"
          >
            + Add New Home
          </a>

          <a
            href="/host/my-homes"
            class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold transition"
          >
            View My Homes
          </a>

        </div>

      </div>

      <div class="bg-white rounded-lg shadow-lg p-8">

        <h2 class="text-2xl font-bold text-gray-800 mb-4">
          Recent Bookings
        </h2>

        <p class="text-gray-600 mb-6">
          Check reservations and manage bookings
        </p>

        <a
          href="/host/my-bookings"
          class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition"
        >
          View All Bookings
        </a>

      </div>

    </div>

  </main>

</body>

</html>
