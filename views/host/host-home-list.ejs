<%- include('../partials/head') %>
</head>

<body>

  <%- include('../partials/nav') %>

  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">

    <h2 class="text-3xl text-red-500 font-bold text-center mb-8">
      My Properties
    </h2>

    <div class="mb-8">
      <a
        href="/host/add-home"
        class="bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-semibold text-lg transition"
      >
        + Add New Home
      </a>
    </div>

    <% if (registeredHomes.length === 0) { %>

      <div class="text-center py-12">
        <p class="text-gray-600 text-xl mb-6">
          You haven't added any homes yet.
        </p>
        <a
          href="/host/add-home"
          class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold transition"
        >
          Add Your First Home
        </a>
      </div>

    <% } else { %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <% registeredHomes.forEach(home => { %>

          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300">

            <img
              src="<%= home.photoUrl %>"
              alt="<%= home.houseName %>"
              class="w-full h-48 object-cover"
            >

            <div class="p-4">

              <h3 class="text-xl font-semibold text-gray-800 mb-2">
                <%= home.houseName %>
              </h3>

              <p class="text-gray-600 mb-2">
                📍 <%= home.location %>
              </p>

              <div class="flex justify-between items-center mb-4">

                <span class="text-lg font-bold text-red-500">
                  Rs<%= home.price %> / night
                </span>

                <div class="flex items-center">
                  <span class="text-yellow-400 text-xl">★</span>
                  <span class="ml-2 text-lg"><%= home.rating %></span>
                </div>

              </div>

              <p class="text-gray-600 text-sm mb-4">
                <%= home.description.substring(0, 100) %>...
              </p>

              <div class="flex gap-3">

                <a
                  href="/host/edit-home/<%= home._id %>"
                  class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition flex-1 text-center"
                >
                  Edit
                </a>

                <form action="/host/delete-home/<%= home._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this home?');">

                  <button
                    type="submit"
                    class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition w-full"
                  >
                    Delete
                  </button>

                </form>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

</body>

</html>