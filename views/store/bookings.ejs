<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <%- include('../partials/head') %>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css"
  />

  <style>

    .booking-map {

      height: 400px;

      border-radius: 10px;

      margin-top: 15px;

      display: none;

    }

    .directions-panel {

      display: none;

    }

  </style>

  <title>
    Bookings
  </title>

</head>

<body class="bg-[#141414] text-[#A0A0A0]">

  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto mt-10 px-6">

    <!-- HERO -->
    <section class="hero-section">

      <div class="text-center max-w-4xl mx-auto pb-16">

        <span class="hero-label">
          YOUR STAYS
        </span>

        <h1 class="hero-title">
          My Bookings
        </h1>

        <p class="text-[#CFC7BA] max-w-2xl mx-auto mt-4">

          View, manage, and get directions
          to all of your reserved homes.

        </p>

      </div>

    </section>

    <!-- MESSAGE -->
    <% if (message) { %>

      <div class="mb-8 max-w-3xl mx-auto">

        <div class="card border-l-4 border-[#C9A84C] p-5">

          <p class="font-semibold text-lg text-[#F5F0E8]">

            Booking Update

          </p>

          <p class="mt-2 text-[#A0A0A0]">

            <%= message %>

          </p>

        </div>

      </div>

    <% } %>

    <!-- BOOKINGS -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">

      <% bookings.forEach(home => { %>

        <div class="card overflow-hidden hover:scale-105 transition duration-300">

          <!-- IMAGE -->
          <img
            src="<%= home.photo %>"
            alt="<%= home.houseName %>"
            class="w-full h-72 object-cover"
          />

          <div class="p-6">

            <!-- HOUSE NAME -->
            <h2 class="text-3xl font-semibold text-[#F5F0E8] mb-3">

              <%= home.houseName %>

            </h2>

            <!-- LOCATION -->
            <p class="text-[#A0A0A0] text-lg mb-5">

              <%= home.location %>

            </p>

            <!-- BOOKING INFO -->
            <div class="space-y-3 text-lg bg-[#0D0D0D] rounded-lg p-4 border border-[#2A2A2A] mb-5">

              <p class="text-[#F5F0E8]">

                <span class="font-semibold">
                  Check-In:
                </span>

                <span class="text-[#A0A0A0]">

                  <%= home.checkIn %>

                </span>

              </p>

              <p class="text-[#F5F0E8]">

                <span class="font-semibold">
                  Check-Out:
                </span>

                <span class="text-[#A0A0A0]">

                  <%= home.checkOut %>

                </span>

              </p>

              <p class="text-[#F5F0E8]">

                <span class="font-semibold">
                  Nights:
                </span>

                <span class="text-[#A0A0A0]">

                  <%= home.totalNights %> night(s)

                </span>

              </p>

              <p class="text-[#C9A84C] text-2xl font-bold pt-2 border-t border-[#2A2A2A]">

                Rs <%= home.totalAmount %>

              </p>

            </div>

            <!-- TOGGLE BUTTON -->
            <button
              class="toggle-directions-btn w-full mb-3 px-4 py-2 rounded bg-blue-500 hover:bg-blue-600 text-white font-semibold transition"
              data-booking-id="<%= home._id %>"
            >

              📍 Show Directions

            </button>

            <!-- PANEL -->
            <div
              id="directions-panel-<%= home._id %>"
              class="directions-panel"
            >

              <!-- USER LOCATION -->
              <div class="mb-3">

                <input
                  type="text"
                  id="userLocation-<%= home._id %>"
                  placeholder="Enter your location..."
                  class="w-full px-4 py-2 rounded bg-[#0D0D0D] border border-[#2A2A2A] text-[#F5F0E8]"
                />

              </div>

              <!-- ROUTE BUTTON -->
              <button
                class="show-route-btn w-full px-4 py-2 rounded bg-[#C9A84C] hover:bg-[#E6D5A3] text-[#0D0D0D] font-bold transition"
                data-booking-id="<%= home._id %>"
                data-lat="<%= home.latitude || home.home.latitude %>"
                data-lng="<%= home.longitude || home.home.longitude %>"
              >

                🗺️ Get Route

              </button>

              <!-- INFO -->
              <div
                id="routeInfo-<%= home._id %>"
                class="hidden mt-3 p-3 bg-[#0D0D0D] rounded border border-[#2A2A2A] text-sm"
              >

                <p class="text-[#F5F0E8]">

                  Distance:

                  <span
                    id="distance-<%= home._id %>"
                    class="text-[#C9A84C] font-bold"
                  >

                    --

                  </span>

                </p>

                <p class="text-[#F5F0E8] mt-1">

                  Travel Time:

                  <span
                    id="time-<%= home._id %>"
                    class="text-[#C9A84C] font-bold"
                  >

                    --

                  </span>

                </p>

              </div>

              <!-- MAP -->
              <div
                id="map-<%= home._id %>"
                class="booking-map"
              ></div>

            </div>

            <!-- CANCEL BOOKING -->
            <form
              action="/cancel-booking"
              method="POST"
              class="mt-5"
            >

              <!-- BOOKING ID -->
              <input
                type="hidden"
                name="bookingId"
                value="<%= home._id %>"
              />

              <!-- FEEDBACK -->
              <textarea
                name="reason"
                required
                placeholder="Why are you cancelling this booking?"
                class="w-full p-3 rounded bg-[#0D0D0D] border border-[#2A2A2A] text-[#F5F0E8] resize-none h-28 mb-3"
              ></textarea>

              <!-- BUTTON -->
              <button
                type="submit"
                class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded transition"
                onclick="return confirm('Are you sure you want to cancel this booking?')"
              >

                Cancel Booking

              </button>

            </form>

          </div>

        </div>

      <% }) %>

    </div>

  </main>

  <!-- LEAFLET -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- ROUTING -->
  <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

  <script>

    const mapInstances = {};

    const routingInstances = {};

    // TOGGLE PANEL
    document.querySelectorAll(
      '.toggle-directions-btn'
    ).forEach(btn => {

      btn.addEventListener(
        'click',
        function () {

          const bookingId =
            this.getAttribute(
              'data-booking-id'
            );

          const panel =
            document.getElementById(
              `directions-panel-${bookingId}`
            );

          if (
            panel.style.display === 'none' ||
            panel.style.display === ''
          ) {

            panel.style.display = 'block';

            this.textContent =
              '🔽 Hide Directions';

          }

          else {

            panel.style.display = 'none';

            this.textContent =
              '📍 Show Directions';

          }

        }
      );

    });

    // GET ROUTE
    document.querySelectorAll(
      '.show-route-btn'
    ).forEach(btn => {

      btn.addEventListener(
        'click',
        async function () {

          const bookingId =
            this.getAttribute(
              'data-booking-id'
            );

          const userAddress =
            document.getElementById(
              `userLocation-${bookingId}`
            ).value.trim();

          const propertyLat =
            parseFloat(
              this.getAttribute(
                'data-lat'
              )
            );

          const propertyLng =
            parseFloat(
              this.getAttribute(
                'data-lng'
              )
            );

          const mapId =
            `map-${bookingId}`;

          const routeInfo =
            document.getElementById(
              `routeInfo-${bookingId}`
            );

          // VALIDATION
          if (!userAddress) {

            alert(
              'Please enter your location.'
            );

            return;

          }

          try {

            // USER LOCATION SEARCH
            const response =
              await fetch(
                `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(userAddress)}&format=json&limit=1`,
                {
                  headers: {
                    'Accept':
                      'application/json'
                  }
                }
              );

            const data =
              await response.json();

            if (data.length === 0) {

              alert(
                'Location not found.'
              );

              return;

            }

            const userLat =
              parseFloat(data[0].lat);

            const userLng =
              parseFloat(data[0].lon);

            // SHOW MAP
            document.getElementById(
              mapId
            ).style.display = 'block';

            routeInfo.classList.remove(
              'hidden'
            );

            // REMOVE OLD MAP
            if (mapInstances[mapId]) {

              mapInstances[mapId].remove();

            }

            // CREATE MAP
            const map =
              L.map(mapId).setView(
                [
                  (userLat + propertyLat) / 2,
                  (userLng + propertyLng) / 2
                ],
                7
              );

            // TILE
            L.tileLayer(
              'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
              {
                attribution:
                  '© OpenStreetMap contributors',
                maxZoom: 19
              }
            ).addTo(map);

            // ROUTING
            const routingControl =
              L.Routing.control({

                waypoints: [
                  L.latLng(
                    userLat,
                    userLng
                  ),
                  L.latLng(
                    propertyLat,
                    propertyLng
                  )
                ],

                routeWhileDragging: false,

                lineOptions: {
                  styles: [
                    {
                      color: 'blue',
                      opacity: 0.7,
                      weight: 5
                    }
                  ]
                },

                createMarker:
                  function(
                    i,
                    waypoint,
                    n
                  ) {

                    const marker =
                      L.marker(
                        waypoint.latLng
                      );

                    if (i === 0) {

                      marker.bindPopup(
                        'Your Location'
                      );

                    }

                    else if (
                      i === n - 1
                    ) {

                      marker.bindPopup(
                        'Property Location'
                      );

                    }

                    return marker;

                  }

              }).addTo(map);

            // ROUTE FOUND
            routingControl.on(
              'routesfound',
              function (e) {

                const route =
                  e.routes[0];

                const distanceKm =
                  (
                    route.summary.totalDistance / 1000
                  ).toFixed(2);

                const timeMinutes =
                  Math.round(
                    route.summary.totalTime / 60
                  );

                document.getElementById(
                  `distance-${bookingId}`
                ).textContent =
                  distanceKm + ' km';

                document.getElementById(
                  `time-${bookingId}`
                ).textContent =
                  timeMinutes + ' min';

              }
            );

            mapInstances[mapId] =
              map;

            routingInstances[mapId] =
              routingControl;

            // FIX MAP SIZE
            setTimeout(() => {
              map.invalidateSize();
            }, 300);

          }

          catch (err) {

            console.error(err);

            alert(
              'Error loading route.'
            );

          }

        }
      );

    });

  </script>

</body>

</html>