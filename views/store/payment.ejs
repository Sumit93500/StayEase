<!DOCTYPE html>
<html lang="en">

<head>

  <title>Payment</title>

  <%- include("../partials/head") %>

</head>

<body class="bg-[#141414] text-[#A0A0A0]">




  <%- include("../partials/nav") %>





  <div class="max-w-7xl mx-auto card mt-10 rounded-3xl p-10">




    <h1 class="text-center text-4xl font-semibold text-[#F5F0E8] mb-10">
      Complete Payment
    </h1>





    <div class="grid grid-cols-2 gap-10">




      <!-- LEFT -->
      <div>

        <img
          src="<%= home.photoUrl %>"
          class="w-full h-[420px] object-cover rounded-2xl"
        />





        <h1 class="text-3xl font-semibold text-[#F5F0E8] mt-8">
          <%= home.houseName %>
        </h1>





        <p class="text-3xl text-[#A0A0A0] mt-3">
          <%= home.city %>
        </p>





        <form
          action="/confirm-booking"
          method="POST"
          id="bookingForm"
        >

          <input
            type="hidden"
            name="homeId"
            value="<%= home._id %>"
          />





          <input
            type="hidden"
            name="houseName"
            value="<%= home.houseName %>"
          />





          <input
            type="hidden"
            name="city"
            value="<%= home.city %>"
          />





          <input
            type="hidden"
            name="photo"
            value="<%= home.photoUrl %>"
          />





          <input
            type="hidden"
            name="price"
            value="<%= home.price %>"
            id="pricePerNight"
          />





          <div class="mt-10">

            <label class="text-2xl font-semibold text-[#F5F0E8]">
              Check-In
            </label>





            <input
              type="date"
              name="checkIn"
              id="checkIn"
              required
              class="w-full border border-[#2A2A2A] p-4 rounded-xl mt-3 text-2xl bg-[#0D0D0D] text-[#F5F0E8]"
            />

          </div>





          <div class="mt-5">

            <label class="text-2xl font-semibold text-[#F5F0E8]">
              Check-Out
            </label>





            <input
              type="date"
              name="checkOut"
              id="checkOut"
              required
              class="w-full border border-[#2A2A2A] p-4 rounded-xl mt-3 text-2xl bg-[#0D0D0D] text-[#F5F0E8]"
            />

          </div>





          <div class="mt-8 space-y-5">

            <h2 class="text-3xl font-semibold text-[#F5F0E8]">
              Check-In:
              <span id="checkInText" class="text-[#A0A0A0]">--</span>
            </h2>





            <h2 class="text-3xl font-semibold text-[#F5F0E8]">
              Check-Out:
              <span id="checkOutText" class="text-[#A0A0A0]">--</span>
            </h2>





            <h2 class="text-3xl font-semibold text-[#F5F0E8]">
              Total Nights:
              <span id="totalNights" class="text-[#A0A0A0]">0</span>
            </h2>





            <h1 class="text-4xl font-bold text-[#C9A84C]">
              Rs<span id="totalAmount" class="text-[#F5F0E8]">0</span>
            </h1>





            <input
              type="hidden"
              name="totalNights"
              id="totalNightsInput"
            />





            <input
              type="hidden"
              name="totalAmount"
              id="totalAmountInput"
            />

          </div>

      </div>





      <!-- RIGHT -->
      <div class="card rounded-3xl p-10">
        <h1 class="text-3xl font-semibold text-center text-[#F5F0E8]">
          Scan & Pay
        </h1>





        <div class="grid grid-cols-2 gap-5 mt-10">




          <div class="card rounded-2xl p-5 text-center">
            <img
              src="/images/qr1.jpg"
              class="w-full h-72 object-contain rounded-xl"
            />
            <h2 class="text-center text-3xl font-semibold text-[#F5F0E8] mt-5">
              Sumit UPI
            </h2>
          </div>





          <div class="card rounded-2xl p-5 text-center">
            <img
              src="/images/qr2.jpg"
              class="w-full h-72 object-contain rounded-xl"
            />
            <h2 class="text-center text-3xl font-semibold text-[#F5F0E8] mt-5">
              Sahbaj UPI
            </h2>
          </div>

        </div>





        <input
          type="text"
          name="transactionId"
          required
          placeholder="Enter Transaction ID"
          class="w-full border border-[#2A2A2A] p-5 rounded-2xl mt-10 text-2xl bg-[#0D0D0D] text-[#F5F0E8]"
        />





        <button
          class="w-full btn-primary text-3xl font-bold mt-8"
        >
          Confirm Booking
        </button>

      </div>

      </form>

    </div>

  </div>





  <script>

    const checkIn =
      document.getElementById("checkIn");

    const checkOut =
      document.getElementById("checkOut");

    const totalNights =
      document.getElementById("totalNights");

    const totalAmount =
      document.getElementById("totalAmount");

    const checkInText =
      document.getElementById("checkInText");

    const checkOutText =
      document.getElementById("checkOutText");

    const pricePerNight =
      document.getElementById("pricePerNight").value;





    function calculatePrice() {

      const inDate =
        new Date(checkIn.value);

      const outDate =
        new Date(checkOut.value);





      checkInText.innerText =
        checkIn.value;

      checkOutText.innerText =
        checkOut.value;





      if (
        checkIn.value &&
        checkOut.value
      ) {

        const diffTime =
          outDate - inDate;

        const nights =
          diffTime /
          (1000 * 60 * 60 * 24);





        totalNights.innerText =
          nights;

        document.getElementById(
          "totalNightsInput"
        ).value = nights;





        const total =
          nights * pricePerNight;





        totalAmount.innerText =
          total;

        document.getElementById(
          "totalAmountInput"
        ).value = total;

      }

    }





    checkIn.addEventListener(
      "change",
      calculatePrice
    );





    checkOut.addEventListener(
      "change",
      calculatePrice
    );

  </script>

</body>

</html>