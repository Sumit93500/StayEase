<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    <%= pageTitle %>
  </title>

  <%- include("../partials/head") %>

</head>

<body class="bg-[#141414] text-[#A0A0A0]">




  <%- include("../partials/nav") %>





  <section class="hero-section">
    <div class="text-center max-w-4xl mx-auto pb-16">
      <span class="hero-label">CURATED COLLECTION</span>
      <h1 class="hero-title">Available Homes</h1>
      <p class="text-[#CFC7BA] max-w-2xl mx-auto mt-4">
        Explore luxury residences selected for serene comfort, privacy, and elevated hospitality.
      </p>
    </div>
  </section>





  <div class="max-w-7xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 gap-10 px-5">




    <% if (registeredHomes.length === 0) { %>
      <h1 class="text-3xl font-semibold text-[#F5F0E8]">
        No Homes Found
      </h1>
    <% } %>





    <% registeredHomes.forEach(home => { %>

      <div
        class="bg-white rounded-2xl overflow-hidden shadow-lg"
      >

        <img
          src="<%= home.photoUrl %>"
          class="w-full h-96 object-cover"
        />





        <div class="p-5">

          <h2 class="text-4xl font-bold">

            <%= home.houseName %>

          </h2>





          <p class="text-2xl text-gray-600 mt-2">

            <%= home.city %>

          </p>





          <div
            class="flex justify-between items-center mt-5"
          >

            <h1
              class="text-5xl font-bold text-red-500"
            >

              Rs<%= home.price %> / night

            </h1>





            <h2 class="text-4xl font-bold">

              ⭐ 4.8

            </h2>

          </div>





          <div class="flex flex-wrap gap-4 mt-6">
            <a
              href="/homes/<%= home._id %>"
              class="btn-secondary"
            >
              View Details
            </a>

            <% if (isLoggedIn && role === "user") { %>
              <a
                href="/reserve/<%= home._id %>"
                class="btn-primary"
              >
                Book Now
              </a>
            <% } %>
          </div>

        </div>

      </div>

    <% }) %>

  </div>

</body>

</html>