<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    <%= pageTitle %>
  </title>

  <%- include("../partials/head") %>

</head>

<body class="bg-gray-100">




  <%- include("../partials/nav") %>





  <div class="text-center mt-10">

    <h1 class="text-5xl font-bold text-red-500">

      Available Homes

    </h1>

  </div>





  <div
    class="max-w-7xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 gap-10 px-5"
  >




    <% if (registeredHomes.length === 0) { %>

      <h1 class="text-3xl font-bold">

        No Homes Found

      </h1>

    <% } %>





    <% registeredHomes.forEach(home => { %>

      <div
        class="bg-white rounded-2xl overflow-hidden shadow-lg"
      >

        <img
          src="<%= home.photoUrl %>"
          class="w-full h-96 object-cover"
        />





        <div class="p-5">

          <h2 class="text-4xl font-bold">

            <%= home.houseName %>

          </h2>





          <p class="text-2xl text-gray-600 mt-2">

            <%= home.city %>

          </p>





          <div
            class="flex justify-between items-center mt-5"
          >

            <h1
              class="text-5xl font-bold text-red-500"
            >

              Rs<%= home.price %> / night

            </h1>





            <h2 class="text-4xl font-bold">

              ⭐ 4.8

            </h2>

          </div>





          <div class="flex gap-4 mt-5">

            <a
              href="/homes/<%= home._id %>"
              class="bg-black hover:bg-gray-800 text-white px-5 py-3 rounded-lg text-2xl"
            >
              View Details
            </a>

            <% if (isLoggedIn && role === "user") { %>

              <a
                href="/reserve/<%= home._id %>"
                class="bg-red-500 hover:bg-red-600 text-white px-5 py-3 rounded-lg text-2xl"
              >
                Book Now
              </a>

            <% } %>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

</body>

</html>