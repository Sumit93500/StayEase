<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= home.houseName %></title>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    #propertyMap {
      height: 400px;
      margin-top: 20px;
      border-radius: 8px;
    }
  </style>
</head>

<body class="bg-[#141414] text-[#A0A0A0]">

  <%- include('../partials/nav') %>

  <main class="max-w-5xl mx-auto card mt-10 overflow-hidden">

    <img
      src="<%= home.photoUrl %>"
      alt="<%= home.houseName %>"
      class="w-full h-[450px] object-cover"
    >

    <div class="p-8">

      <div class="flex flex-col gap-4 md:flex-row md:justify-between md:items-center mb-6">

        <h1 class="text-4xl font-semibold text-[#F5F0E8]">
          <%= home.houseName %>
        </h1>

        <div class="text-[#C9A84C] text-2xl font-bold">
          ⭐ <%= home.rating %>
        </div>

      </div>

      <p class="text-xl text-[#A0A0A0] mb-6">
        📍 <%= home.location %>
      </p>

      <p class="text-3xl font-bold text-[#C9A84C] mb-8">
        ₹<%= home.price %> / night
      </p>

      <div class="card p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-3 text-[#F5F0E8]">
          About this home
        </h2>
        <p class="text-[#A0A0A0] leading-8 text-lg">
          <%= home.description %>
        </p>
      </div>

      <div class="card p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-3 text-[#F5F0E8]">
          Property Location
        </h2>
        <div id="propertyMap"></div>
      </div>

      <div class="flex flex-wrap gap-4">

        <% if (isLoggedIn && role === "user") { %>
          <form action="/reserve/<%= home._id %>" method="GET">
            <button
              type="submit"
              class="btn-primary"
            >
              Book Now
            </button>
          </form>
          <form action="/favourites" method="POST">
            <input
              type="hidden"
              name="id"
              value="<%= home._id %>"
            >
            <button
              class="btn-secondary"
            >
              Add To Favourite
            </button>
          </form>
        <% } else { %>
          <div class="card p-5 border border-[#2A2A2A] text-[#CFC7BA]">
            Please log in to book this home or save it to favourites.
          </div>
        <% } %>

      </div>

    </div>

  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const lat = <%= home.latitude || 26.9124 %>;
      const lng = <%= home.longitude || 75.7873 %>;

      const map = L.map('propertyMap').setView([lat, lng], 13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
      }).addTo(map);

      L.marker([lat, lng]).addTo(map).bindPopup('<strong><%= home.houseName %></strong><br><%= home.location %>');
    });
  </script>

</body>
</html>