<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <%- include('../partials/head') %>
</head>

<body class="bg-[#141414] text-[#A0A0A0]">

  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6">

    <section class="hero-section">
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.9fr] items-center">
        <div>
          <span class="hero-label">LUXURY ESCAPES</span>
          <h1 class="hero-title">Stay in premium homes designed for exceptional stays.</h1>
          <p class="max-w-xl text-[#CFC7BA] mb-8">
            Discover high-end villas, designer retreats, and skyline residences curated for comfort, privacy, and unforgettable experiences.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#homes" class="btn-primary">Explore Homes</a>
            <a href="/signup" class="btn-secondary">Become a Host</a>
          </div>
        </div>

        <div class="hero-card p-8">
          <p class="text-[#CFC7BA] uppercase tracking-[0.2em] text-xs mb-4">Featured Service</p>
          <h2 class="text-3xl font-semibold text-white mb-4">Private rooftop villa experience</h2>
          <p class="text-[#CFC7BA] mb-6">Exclusive concierge support, premium amenities and a dramatic city view tailored for elevated travel.</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-[#2A2A2A] p-4">
              <p class="text-[#CFC7BA] text-sm">Location</p>
              <p class="text-white font-semibold">Mumbai</p>
            </div>
            <div class="rounded-xl border border-[#2A2A2A] p-4">
              <p class="text-[#CFC7BA] text-sm">Rating</p>
              <p class="text-white font-semibold">4.9 / 5</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="homes" class="section">
      <% if (registeredHomes.length === 0) { %>

        <div class="text-center mt-20">
          <h2 class="text-3xl font-semibold text-[#F5F0E8]">
            No Homes Available
          </h2>
        </div>

      <% } else { %>

        <div class="flex flex-col gap-4 mb-8">
          <div>
            <p class="badge-gold">Premium Collection</p>
            <h2 class="text-3xl font-semibold mt-4 text-[#F5F0E8]">Featured Homes</h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% registeredHomes.forEach(home => { %>
            <div class="card overflow-hidden">
              <img
                src="<%= home.photoUrl %>"
                alt="<%= home.houseName %>"
                class="w-full h-80 object-cover"
              />
              <div class="p-6">
                <h2 class="text-3xl font-semibold text-[#F5F0E8] mb-2">
                  <%= home.houseName %>
                </h2>
                <p class="text-[#A0A0A0] text-lg mb-4">
                  <%= home.location %>
                </p>
                <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6">
                  <h3 class="text-[#C9A84C] text-3xl font-bold">
                    Rs<%= home.price %> / night
                  </h3>
                  <p class="text-[#F5F0E8] text-lg font-semibold">
                    ⭐ <%= home.rating %>
                  </p>
                </div>
                <div class="flex flex-wrap gap-3">
                  <% if (isLoggedIn && role === "user") { %>
                    <a
                      href="/reserve/<%= home._id %>"
                      class="btn-primary"
                    >
                      Book Now
                    </a>
                  <% } %>
                  <a
                    href="/homes/<%= home._id %>"
                    class="btn-secondary"
                  >
                    View Details
                  </a>
                  <% if (isLoggedIn && role === "user") { %>
                    <form action="/favourites" method="POST" class="min-w-max">
                      <input type="hidden" name="id" value="<%= home._id %>" />
                      <button type="submit" class="btn-secondary">
                        Add Favourite
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>
    </section>
  </main>

</body>
</html>