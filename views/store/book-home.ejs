<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Complete Payment</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100">
    <%- include('../partials/nav') %>

    <main class="max-w-6xl mx-auto mt-10 bg-white p-10 rounded-3xl shadow-lg">
      <h1 class="text-5xl font-bold text-center text-red-500 mb-10">
        Complete Payment
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- LEFT -->
        <div>
          <img
            src="<%= home.photoUrl %>"
            class="w-full h-[500px] object-cover rounded-3xl"
          />

          <h2 class="text-5xl font-bold mt-6"><%= home.houseName %></h2>

          <p class="text-3xl text-gray-600 mt-3"><%= home.city %></p>

          <div class="mt-8 space-y-4">
            <h3 class="text-2xl font-bold">
              Check-In:
              <span class="font-normal"> <%= checkIn %> </span>
            </h3>

            <h3 class="text-2xl font-bold">
              Check-Out:
              <span class="font-normal"> <%= checkOut %> </span>
            </h3>

            <h3 class="text-2xl font-bold">
              Total Nights:
              <span class="font-normal"> <%= totalNights %> </span>
            </h3>

            <h2 class="text-5xl font-bold text-red-500 mt-6">
              Rs<%= totalAmount %>
            </h2>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="bg-gray-100 p-8 rounded-3xl">
          <h2 class="text-4xl font-bold text-center mb-8">Scan & Pay</h2>

          <div class="grid grid-cols-2 gap-6">
            <div class="bg-white p-5 rounded-2xl shadow-lg text-center">
              <img
                src="/images/Scanner.jpeg"
                class="w-full h-72 object-contain rounded-xl"
              />

              <h3 class="text-2xl font-bold mt-4">Sumit UPI</h3>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-lg text-center">
              <img
                src="/images/Scanner-Sahbaj.jpeg"
                class="w-full h-72 object-contain rounded-xl"
              />

              <h3 class="text-2xl font-bold mt-4">Sahbaj UPI</h3>
            </div>
          </div>

          <form action="/confirm-booking" method="POST" class="mt-10">
            <input type="hidden" name="homeId" value="<%= home._id %>" />

            <input type="hidden" name="checkIn" value="<%= checkIn %>" />

            <input type="hidden" name="checkOut" value="<%= checkOut %>" />

            <input
              type="hidden"
              name="totalNights"
              value="<%= totalNights %>"
            />

            <input
              type="hidden"
              name="totalAmount"
              value="<%= totalAmount %>"
            />

            <input
              type="text"
              name="transactionId"
              placeholder="Enter Transaction ID"
              required
              class="w-full p-5 border-2 rounded-2xl text-xl mb-6"
            />

            <button
              type="submit"
              class="w-full bg-red-500 hover:bg-red-600 text-white text-2xl font-bold py-5 rounded-2xl transition"
            >
              Confirm Booking
            </button>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
