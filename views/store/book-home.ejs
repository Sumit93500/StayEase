<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Complete Payment</title>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-[#141414] text-[#A0A0A0]">
    <%- include('../partials/nav') %>

    <main class="max-w-6xl mx-auto mt-10 card p-8 lg:p-10">
      <h1 class="text-4xl font-semibold text-center text-[#F5F0E8] mb-10">
        Complete Payment
      </h1>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        <!-- LEFT -->
        <div>
          <img
            src="<%= home.photoUrl %>"
            class="w-full h-[500px] object-cover rounded-3xl"
          />

          <h2 class="text-3xl font-semibold text-[#F5F0E8] mt-6"><%= home.houseName %></h2>

          <p class="text-2xl text-[#A0A0A0] mt-3"><%= home.city %></p>

          <div class="mt-8 space-y-4">
            <div class="rounded-2xl border border-[#2A2A2A] p-6 bg-[#141414]">
              <h3 class="text-2xl font-semibold text-[#F5F0E8]">
                Check-In:
                <span class="font-normal text-[#A0A0A0]"> <%= checkIn %> </span>
              </h3>
            </div>
            <div class="rounded-2xl border border-[#2A2A2A] p-6 bg-[#141414]">
              <h3 class="text-2xl font-semibold text-[#F5F0E8]">
                Check-Out:
                <span class="font-normal text-[#A0A0A0]"> <%= checkOut %> </span>
              </h3>
            </div>
            <div class="rounded-2xl border border-[#2A2A2A] p-6 bg-[#141414]">
              <h3 class="text-2xl font-semibold text-[#F5F0E8]">
                Total Nights:
                <span class="font-normal text-[#A0A0A0]"> <%= totalNights %> </span>
              </h3>
            </div>
            <div class="rounded-2xl border border-[#2A2A2A] p-6 bg-[#141414]">
              <h2 class="text-3xl font-bold text-[#C9A84C]">
                Rs<%= totalAmount %>
              </h2>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="card p-8 rounded-3xl">
          <h2 class="text-2xl font-semibold text-center text-[#F5F0E8] mb-8">Scan & Pay</h2>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="card p-5 text-center">
              <img
                src="/images/Scanner.jpeg"
                class="w-full h-72 object-contain rounded-xl"
              />
              <h3 class="text-2xl font-semibold text-[#F5F0E8] mt-4">Sumit UPI</h3>
            </div>

            <div class="card p-5 text-center">
              <img
                src="/images/Scanner-Sahbaj.jpeg"
                class="w-full h-72 object-contain rounded-xl"
              />
              <h3 class="text-2xl font-semibold text-[#F5F0E8] mt-4">Sahbaj UPI</h3>
            </div>
          </div>

          <form action="/confirm-booking" method="POST" class="mt-10">
            <input type="hidden" name="homeId" value="<%= home._id %>" />
            <input type="hidden" name="checkIn" value="<%= checkIn %>" />
            <input type="hidden" name="checkOut" value="<%= checkOut %>" />
            <input type="hidden" name="totalNights" value="<%= totalNights %>" />
            <input type="hidden" name="totalAmount" value="<%= totalAmount %>" />

            <input
              type="text"
              name="transactionId"
              placeholder="Enter Transaction ID"
              required
              class="w-full p-5 border border-[#2A2A2A] rounded-2xl text-xl mb-6 bg-[#0D0D0D] text-[#F5F0E8]"
            />

            <button
              type="submit"
              class="w-full btn-primary text-center"
            >
              Confirm Booking
            </button>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
