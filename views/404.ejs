<%- include('partials/head') %>
  </head>
  <body class="bg-[#141414] text-[#A0A0A0]">
    <%- include('partials/nav') %>
    <main class="container mx-auto mt-20 px-4 text-center py-16">
      <h2 class="text-8xl font-serif text-[#C9A84C] mb-4 font-light">404</h2>
      <p class="text-3xl font-semibold text-[#F5F0E8] mb-4">Page Not Found</p>
      <p class="text-[#A0A0A0] max-w-xl mx-auto mb-8">
        The page you're looking for doesn't exist. Please return to the home page to continue exploring.
      </p>
      <a
        href="<%= typeof role !== 'undefined' && role === 'host' ? '/host' : '/' %>"
        class="btn-primary"
      >
        Return to Home
      </a>
    </main>
  </body>
</html>