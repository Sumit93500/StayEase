<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Signup</title>
  </head>

  <body class="bg-gray-100 flex justify-center items-center min-h-screen">
    <form
      action="/signup"
      method="POST"
      class="bg-white p-10 rounded-2xl shadow-2xl w-full max-w-lg"
    >
      <h1 class="text-4xl font-bold text-center text-red-500 mb-8">
        Create Account
      </h1>

      <input
        type="text"
        name="fullName"
        placeholder="Full Name"
        required
        class="w-full border border-gray-300 rounded-xl px-5 py-4 mb-5"
      />

      <input
        type="email"
        name="email"
        placeholder="Email"
        required
        class="w-full border border-gray-300 rounded-xl px-5 py-4 mb-5"
      />

      <input
        type="password"
        name="password"
        placeholder="Password"
        required
        class="w-full border border-gray-300 rounded-xl px-5 py-4 mb-5"
      />

      <select
        name="role"
        required
        class="w-full border border-gray-300 rounded-xl px-5 py-4 mb-5"
      >
        <option value="user">User</option>

        <option value="host">Host</option>
      </select>

      <button
        type="submit"
        class="w-full bg-red-500 hover:bg-red-600 text-white py-4 rounded-xl text-xl font-bold"
      >
        Signup
      </button>

      <p class="text-center mt-5">
        Already have account?

        <a href="/login" class="text-red-500 font-bold"> Login </a>
      </p>
    </form>
  </body>
</html>
