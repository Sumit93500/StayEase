<!DOCTYPE html>

<html>
  <head>
    <title>Login</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100">
    <%- include("../partials/nav") %>

    <div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-lg mt-20">
      <h1 class="text-4xl font-bold text-center text-red-500 mb-8">Login</h1>

      <form action="/login" method="POST">
        <input
          type="email"
          name="email"
          placeholder="Enter Email"
          required
          class="w-full border p-4 rounded-lg mb-5 text-xl"
        />

        <input
          type="password"
          name="password"
          placeholder="Enter Password"
          required
          class="w-full border p-4 rounded-lg mb-5 text-xl"
        />

        <button
          class="w-full bg-red-500 text-white p-4 rounded-lg text-2xl font-bold"
        >
          Login
        </button>
      </form>
    </div>
  </body>
</html>
